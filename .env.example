NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Meta app / Instagram professional account (server-only)
INSTAGRAM_APP_SECRET=your-meta-app-secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-token
INSTAGRAM_ACCOUNT_ID=your-instagram-professional-account-id
INSTAGRAM_ACCESS_TOKEN=your-long-lived-access-token

# Transactional booking confirmations via Resend (server-only)
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM="BOOM Cleaning <bookings@your-verified-domain.com>"
# Used to invoke the protected email outbox worker manually.
AUTOMATION_WORKER_SECRET=generate-another-long-random-token
# Optional: Vercel Cron sends this in the Authorization header when configured.
CRON_SECRET=generate-a-different-long-random-token
